{
  "name": "yishentong-ai",
  "version": "0.1.0",
  "private": true,
  "description": "医审通 AI：中文医疗事前审核与补件助手",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "build": "npm --workspace apps/api run build && npm --workspace apps/web run build",
    "test": "npm --workspace apps/api run test"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
